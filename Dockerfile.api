# syntax=docker/dockerfile:1.7

ARG GITNEXUS_RUNTIME_IMAGE=legacy-pilot-gitnexus-runtime:local
FROM ${GITNEXUS_RUNTIME_IMAGE} AS gitnexus-runtime

FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LEGACY_PILOT_REPO_IMPORT_ROOT=/var/lib/legacy-pilot/repos

COPY --from=gitnexus-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=gitnexus-runtime /usr/local/bin/gitnexus /usr/local/bin/gitnexus
COPY --from=gitnexus-runtime /opt/gitnexus /opt/gitnexus

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /usr/sbin/nologin legacy \
    && mkdir -p /var/lib/legacy-pilot/repos \
    && test -f /opt/gitnexus/dist/cli/index.js \
    && python -c "from pathlib import Path; root=Path('/opt/gitnexus/node_modules/@ladybugdb/core'); native=next(root.rglob('lbugjs.node'), None); assert native is not None, 'LadybugDB native module not found'; assert native.read_bytes()[:4] == b'\x7fELF', 'GitNexus native module is not a Linux ELF binary'"

WORKDIR /app

COPY pyproject.toml README.md ./
COPY legacy_pilot ./legacy_pilot

RUN python -m pip install --upgrade pip \
    && python -m pip install .

RUN chown -R legacy:legacy /app /var/lib/legacy-pilot /opt/gitnexus

USER legacy

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=12 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=5).read()"

CMD ["python", "-m", "uvicorn", "legacy_pilot.middleware.app:app", "--host", "0.0.0.0", "--port", "8000"]
