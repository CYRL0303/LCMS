# Real Structure1 -> PostgreSQL -> Middleware -> Structure2 E2E.
# Copy to .env for local runs. Do not commit real secrets.

# Opt-in gates. Keep 0 by default so normal pytest never touches external systems.
LEGACY_PILOT_RUN_REAL_E2E=0
LEGACY_PILOT_RUN_POSTGRES_GRAPH_STORE=0
LEGACY_PILOT_RUN_GITNEXUS_INTEGRATION=0

# Structure1 backend.
LEGACY_PILOT_CODE_CORE_BACKEND=gitnexus_cli
GITNEXUS_BIN=<path-to-gitnexus-cli>
GITNEXUS_REPO_ROOT=<path-to-gitnexus-runtime-repo-if-required>
GITNEXUS_TIMEOUT_SECONDS=60
GITNEXUS_INDEX_TIMEOUT_SECONDS=120
GITNEXUS_QUERY_TIMEOUT_SECONDS=30
LEGACY_PILOT_GITNEXUS_FORCE_ANALYZE=1
LEGACY_PILOT_MAX_GRAPH_NODES=5000
LEGACY_PILOT_MAX_GRAPH_EDGES=10000

# PostgreSQL graph payload store.
LEGACY_PILOT_GRAPH_STORE_BACKEND=postgresql
LEGACY_PILOT_GRAPH_STORE_DSN=postgresql://legacy_pilot:legacy_pilot@127.0.0.1:55432/legacy_pilot?connect_timeout=5
LEGACY_PILOT_GRAPH_STORE_TABLE=legacy_pilot_graph_payloads_e2e
LEGACY_PILOT_GRAPH_STORE_TEST_TABLE=legacy_pilot_graph_payloads_e2e_probe

# Structure2 incident context builder.
LEGACY_PILOT_INCIDENT_CONTEXT_BACKEND=graph_context

# Structure3 RCA reasoning engine. Real Qwen is the default; no default mock.
LEGACY_PILOT_RCA_BACKEND=qwen_api
LEGACY_PILOT_RCA_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LEGACY_PILOT_RCA_MODEL=qwen-plus
LEGACY_PILOT_RCA_CONFIDENCE_CAP=0.75
LEGACY_PILOT_RCA_REPAIR_ATTEMPTS=2
DASHSCOPE_API_KEY=<set-outside-git>
